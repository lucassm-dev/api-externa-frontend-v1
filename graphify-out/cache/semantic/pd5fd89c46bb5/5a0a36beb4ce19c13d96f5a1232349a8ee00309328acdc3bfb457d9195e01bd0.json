{"nodes": [{"id": "_spec_features_dashboard_spec_dashboard", "label": "Feature: Dashboard (consolidado por moeda)", "file_type": "document", "source_file": ".spec/features/dashboard/spec.md", "source_location": "L1-L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Porta de entrada da aplica\u00e7\u00e3o. Sem endpoint de agregado no backend, o consolidado \u00e9 montado no cliente a partir das carteiras e das posi\u00e7\u00f5es de cada uma."}, {"id": "_spec_features_dashboard_spec_us_025", "label": "US-025 \u2014 Ver o consolidado das minhas carteiras", "file_type": "document", "source_file": ".spec/features/dashboard/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_spec_features_dashboard_spec_us_026", "label": "US-026 \u2014 Confiar no que o dashboard mostra enquanto ele carrega", "file_type": "document", "source_file": ".spec/features/dashboard/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_spec_features_dashboard_spec_us_027", "label": "US-027 \u2014 Ver meu hist\u00f3rico de aportes", "file_type": "document", "source_file": ".spec/features/dashboard/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_spec_features_dashboard_spec_consolidado_por_moeda", "label": "Consolidado por moeda, sem convers\u00e3o cambial", "file_type": "rationale", "source_file": ".spec/features/dashboard/spec.md", "source_location": "L6-L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Carteiras BR s\u00e3o expressas em BRL e US em USD, e n\u00e3o h\u00e1 convers\u00e3o cambial, ent\u00e3o o consolidado \u00e9 sempre apresentado por moeda lado a lado, nunca somado. Como o backend n\u00e3o tem endpoint de agregado, o consolidado custa uma consulta de carteiras mais uma por carteira."}, {"id": "_spec_features_dashboard_spec_carregamento_progressivo_e_degradacao_parcial", "label": "Carregamento progressivo e total parcial", "file_type": "rationale", "source_file": ".spec/features/dashboard/spec.md", "source_location": "L71-L103", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cada bloco carrega por conta pr\u00f3pria: falha nas posi\u00e7\u00f5es de uma carteira degrada s\u00f3 aquele bloco e o total se anuncia como parcial, mas falha ao listar as carteiras impede o consolidado inteiro \u2014 um total incompleto que se passa por completo levaria a decis\u00e3o errada."}], "edges": [{"source": "_spec_features_dashboard_spec_dashboard", "target": "_spec_features_dashboard_spec_us_025", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".spec/features/dashboard/spec.md", "source_location": null, "weight": 1.0}, {"source": "_spec_features_dashboard_spec_dashboard", "target": "_spec_features_dashboard_spec_us_026", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".spec/features/dashboard/spec.md", "source_location": null, "weight": 1.0}, {"source": "_spec_features_dashboard_spec_dashboard", "target": "_spec_features_dashboard_spec_us_027", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".spec/features/dashboard/spec.md", "source_location": null, "weight": 1.0}, {"source": "_spec_features_dashboard_spec_dashboard", "target": "_spec_features_dashboard_spec_consolidado_por_moeda", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".spec/features/dashboard/spec.md", "source_location": null, "weight": 1.0}, {"source": "_spec_features_dashboard_spec_dashboard", "target": "_spec_features_dashboard_spec_carregamento_progressivo_e_degradacao_parcial", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_
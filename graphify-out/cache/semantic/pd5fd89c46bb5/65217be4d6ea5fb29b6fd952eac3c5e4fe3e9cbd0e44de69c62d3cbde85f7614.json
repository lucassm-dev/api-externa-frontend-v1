{"nodes": [{"id": "_spec_features_carteiras_spec_carteiras", "label": "Feature: Carteiras", "file_type": "document", "source_file": ".spec/features/carteiras/spec.md", "source_location": "L1-L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Carteiras de acompanhamento separam teses sem movimentar dinheiro real; cada uma pertence a um investidor de contexto, a uma corretora ativa e a um \u00fanico mercado (BR/BRL ou US/USD)."}, {"id": "_spec_features_carteiras_spec_us_016", "label": "US-016 \u2014 Consultar minhas carteiras", "file_type": "document", "source_file": ".spec/features/carteiras/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_spec_features_carteiras_spec_us_017", "label": "US-017 \u2014 Criar uma carteira", "file_type": "document", "source_file": ".spec/features/carteiras/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_spec_features_carteiras_spec_us_018", "label": "US-018 \u2014 Renomear uma carteira", "file_type": "document", "source_file": ".spec/features/carteiras/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_spec_features_carteiras_spec_us_019", "label": "US-019 \u2014 Excluir uma carteira", "file_type": "document", "source_file": ".spec/features/carteiras/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_spec_features_carteiras_spec_exclusao_logica_de_carteira", "label": "Exclus\u00e3o l\u00f3gica com confirma\u00e7\u00e3o por nome", "file_type": "rationale", "source_file": ".spec/features/carteiras/spec.md", "source_location": "L144-L174", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A carteira sai das listagens mas o hist\u00f3rico de opera\u00e7\u00f5es permanece no backend; o bot\u00e3o destrutivo s\u00f3 habilita com o nome digitado exatamente, e n\u00e3o h\u00e1 remo\u00e7\u00e3o otimista \u2014 falha mant\u00e9m a linha e o modal."}, {"id": "_spec_features_carteiras_spec_releitura_da_pagina_apos_mutacao", "label": "Releitura da p\u00e1gina ap\u00f3s muta\u00e7\u00e3o", "file_type": "rationale", "source_file": ".spec/features/carteiras/spec.md", "source_location": "L112-L143", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Depois de criar, renomear ou excluir, a feature rel\u00ea a p\u00e1gina atual em vez de alterar a lista localmente, para respeitar a ordena\u00e7\u00e3o do servidor; carteira que sumiu entre a listagem e a a\u00e7\u00e3o faz a p\u00e1gina recarregar e avisa a indisponibilidade."}], "edges": [{"source": "_spec_features_carteiras_spec_carteiras", "target": "_spec_features_carteiras_spec_us_016", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".spec/features/carteiras/spec.md", "source_location": null, "weight": 1.0}, {"source": "_spec_features_carteiras_spec_carteiras", "target": "_spec_features_carteiras_spec_us_017", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".spec/features/carteiras/spec.md", "source_location": null, "weight": 1.0}, {"source": "_spec_features_carteiras_spec_carteiras", "target": "_spec_features_carteiras_spec_us_018", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".spec/features/carteiras/spec.md", "source_location": null, "weight": 1.0}, {"source": "_spec_features_carteiras_spec_carteiras", "target": "_spec_features_carteiras_spec_us_019", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".spec/features/carteiras/spec.md", "source_location": null, "weight": 1.0}, {"source": "_spec_features_carteiras_spec_carteiras", "target": "_spec_features_carteiras
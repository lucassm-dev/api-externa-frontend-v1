{"nodes": [{"id": "_spec_features_corretoras_spec_corretoras", "label": "Feature: Corretoras", "file_type": "document", "source_file": ".spec/features/corretoras/spec.md", "source_location": "L1-L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cat\u00e1logo global cadastrado s\u00f3 pelo CNPJ; o backend enriquece com Receita, CVM e CEP. Corretora n\u00e3o autorizada ou n\u00e3o verific\u00e1vel n\u00e3o \u00e9 cadastrada."}, {"id": "_spec_features_corretoras_spec_us_008", "label": "US-008 \u2014 Cadastrar corretora pelo CNPJ", "file_type": "document", "source_file": ".spec/features/corretoras/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_spec_features_corretoras_spec_us_009", "label": "US-009 \u2014 Consultar as corretoras cadastradas", "file_type": "document", "source_file": ".spec/features/corretoras/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_spec_features_corretoras_spec_us_010", "label": "US-010 \u2014 Buscar corretora pelo CNPJ", "file_type": "document", "source_file": ".spec/features/corretoras/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_spec_features_corretoras_spec_us_011", "label": "US-011 \u2014 Excluir corretora", "file_type": "document", "source_file": ".spec/features/corretoras/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_spec_features_corretoras_spec_enriquecimento_por_cnpj", "label": "Cadastro de corretora enriquecido s\u00f3 pelo CNPJ", "file_type": "rationale", "source_file": ".spec/features/corretoras/spec.md", "source_location": "L12-L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Todo dado cadastral vem de fonte externa e nenhum \u00e9 digitado, o que tamb\u00e9m explica por que n\u00e3o existe edi\u00e7\u00e3o. O encadeamento em s\u00e9rie de Receita, CVM e CEP pode levar dezenas de segundos: a espera precisa aparecer na tela e o cliente n\u00e3o imp\u00f5e tempo limite."}, {"id": "_spec_features_corretoras_spec_verificacao_cvm_vs_irregularidade", "label": "Verifica\u00e7\u00e3o da CVM falha \u2260 corretora irregular", "file_type": "rationale", "source_file": ".spec/features/corretoras/spec.md", "source_location": "L56-L62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Os dois casos chegam com o mesmo c\u00f3digo de status e s\u00f3 diferem pelo texto, que j\u00e1 vem escrito para pessoas (decis\u00e3o D-10); o cliente exibe a mensagem do backend como veio em vez de classificar por compara\u00e7\u00e3o de texto e acusar de irregular quem apenas n\u00e3o p\u00f4de ser verificado."}], "edges": [{"source": "_spec_features_corretoras_spec_corretoras", "target": "_spec_features_corretoras_spec_us_008", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".spec/features/corretoras/spec.md", "source_location": null, "weight": 1.0}, {"source": "_spec_features_corretoras_spec_corretoras", "target": "_spec_features_corretoras_spec_us_009", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".spec/features/corretoras/spec.md", "source_location": null, "weight": 1.0}, {"source": "_spec_features_corretoras_spec_corretoras", "target": "_spec_features_corretoras_spec_us_010", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".spec/features/corretoras/spec.md", "source_location": null, "weight": 1.0}, {"source": "_spec_features_corretoras_spec_corretoras", "target": "_spec_features_corretoras_spec_us_011", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".spec/features/corretoras/spec.md", "source_loc